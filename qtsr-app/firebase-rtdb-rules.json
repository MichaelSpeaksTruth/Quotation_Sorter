{
  "rules": {
    ".read": false,
    ".write": false,
    
    "users": {
      "$uid": {
        ".read": "$uid === auth.uid && auth.uid !== null",
        ".write": "$uid === auth.uid && auth.uid !== null"
      }
    },
    
    "sessions": {
      "users": {
        "$uid": {
          "active": {
            ".read": "$uid === auth.uid && auth.uid !== null",
            ".write": "$uid === auth.uid && auth.uid !== null",
            "$sessionId": {
              ".read": "$uid === auth.uid && auth.uid !== null",
              ".write": "$uid === auth.uid && auth.uid !== null",
              ".validate": "newData.hasChildren(['id', 'userId', 'device', 'browser', 'os', 'ipAddress', 'location', 'createdAt', 'lastActiveAt'])"
            }
          },
          "past": {
            ".read": "$uid === auth.uid && auth.uid !== null",
            ".write": "$uid === auth.uid && auth.uid !== null",
            ".indexOn": ["endedAt"],
            "$sessionId": {
              ".read": "$uid === auth.uid && auth.uid !== null",
              ".write": "$uid === auth.uid && auth.uid !== null",
              ".validate": "newData.hasChildren(['id', 'userId', 'device', 'browser', 'os', 'ipAddress', 'location', 'createdAt', 'endedAt', 'duration', 'locations'])"
            }
          }
        }
      },
      "$sessionId": {
        ".read": "auth.uid !== null",
        ".write": "auth.uid !== null"
      }
    },
    
    "audit": {
      "users": {
        "$uid": {
          "events": {
            ".read": "$uid === auth.uid && auth.uid !== null",
            ".write": "$uid === auth.uid && auth.uid !== null",
            ".indexOn": ["timestamp"],
            "$eventId": {
              ".read": "$uid === auth.uid && auth.uid !== null",
              ".write": "$uid === auth.uid && auth.uid !== null",
              ".validate": "newData.hasChildren(['id', 'userId', 'type', 'ipAddress', 'device', 'location', 'timestamp', 'status'])"
            }
          }
        }
      }
    },
    
    "quotations": {
      "$uid": {
        ".read": "$uid === auth.uid && auth.uid !== null",
        ".write": "$uid === auth.uid && auth.uid !== null",
        
        "$sessionId": {
          "$quoteId": {
            "vendorName": {
              ".validate": "newData.isString()"
            },
            "fileUrl": {
              ".validate": "newData.isString()"
            },
            "status": {
              ".validate": "newData.val() === 'processing' || newData.val() === 'analyzed' || newData.val() === 'error' || newData.val() === 'canceled'"
            },
            "uploadedAt": {
              ".validate": "newData.isNumber()"
            },
            "updatedAt": {
              ".validate": "!newData.exists() || newData.isNumber()"
            },
            "parsedData": {
              ".validate": "!newData.exists() || newData.val() !== null"
            },
            "finalJsonReport": {
              ".validate": "!newData.exists() || newData.val() !== null"
            },
            "precisionValidation": {
              ".validate": "!newData.exists() || newData.val() === 'PASS' || newData.val() === 'FAIL' || newData.val() === 'UNKNOWN'"
            },
            "unitConversions": {
              ".validate": "!newData.exists() || newData.val() !== null"
            },
            "measurementPrecisionErrors": {
              ".validate": "!newData.exists() || newData.val() !== null"
            },
            "measurementComparisons": {
              ".validate": "!newData.exists() || newData.val() !== null"
            },
            "errorMessage": {
              ".validate": "!newData.exists() || newData.isString()"
            },
            "errorAt": {
              ".validate": "!newData.exists() || newData.isNumber()"
            },
            "canceledAt": {
              ".validate": "!newData.exists() || newData.isNumber()"
            },
            "canceledReason": {
              ".validate": "!newData.exists() || newData.isString()"
            }
          }
        }
      }
    }
  }
}
