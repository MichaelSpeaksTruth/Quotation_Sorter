{
  "rules": {
    ".read": false,
    ".write": false,
    
    "users": {
      "$uid": {
        ".read": "$uid === auth.uid && auth.uid !== null",
        ".write": "$uid === auth.uid && auth.uid !== null",
        ".validate": "newData.hasChildren(['email', 'createdAt'])"
      }
    },
    
    "sessions": {
      "$uid": {
        ".read": "$uid === auth.uid && auth.uid !== null",
        ".write": "$uid === auth.uid && auth.uid !== null",
        
        "$sessionId": {
          "title": {
            ".validate": "newData.isString() && newData.val().length > 0"
          },
          "status": {
            ".validate": "newData.val() === 'open' || newData.val() === 'closed'"
          },
          "createdAt": {
            ".validate": "newData.isNumber()"
          },
          "baseRequirements": {
            ".validate": "!newData.exists() || newData.val() !== null"
          },
          "adjudicationResult": {
            ".validate": "!newData.exists() || newData.val() !== null"
          },
          "adjudicatedAt": {
            ".validate": "!newData.exists() || newData.isNumber()"
          }
        }
      }
    },
    
    "quotations": {
      "$uid": {
        ".read": "$uid === auth.uid && auth.uid !== null",
        ".write": "$uid === auth.uid && auth.uid !== null",
        
        "$sessionId": {
          "$quoteId": {
            "vendorName": {
              ".validate": "newData.isString()"
            },
            "fileUrl": {
              ".validate": "newData.isString()"
            },
            "status": {
              ".validate": "newData.val() === 'processing' || newData.val() === 'analyzed' || newData.val() === 'error' || newData.val() === 'canceled'"
            },
            "uploadedAt": {
              ".validate": "newData.isNumber()"
            },
            "updatedAt": {
              ".validate": "!newData.exists() || newData.isNumber()"
            },
            "parsedData": {
              ".validate": "!newData.exists() || newData.val() !== null"
            },
            "finalJsonReport": {
              ".validate": "!newData.exists() || newData.val() !== null"
            },
            "precisionValidation": {
              ".validate": "!newData.exists() || newData.val() === 'PASS' || newData.val() === 'FAIL' || newData.val() === 'UNKNOWN'"
            },
            "unitConversions": {
              ".validate": "!newData.exists() || newData.val() !== null"
            },
            "measurementPrecisionErrors": {
              ".validate": "!newData.exists() || newData.val() !== null"
            },
            "measurementComparisons": {
              ".validate": "!newData.exists() || newData.val() !== null"
            },
            "errorMessage": {
              ".validate": "!newData.exists() || newData.isString()"
            },
            "errorAt": {
              ".validate": "!newData.exists() || newData.isNumber()"
            },
            "canceledAt": {
              ".validate": "!newData.exists() || newData.isNumber()"
            },
            "canceledReason": {
              ".validate": "!newData.exists() || newData.isString()"
            }
          }
        }
      }
    }
  }
}
